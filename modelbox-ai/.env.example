# =============================================================================
# ModelBox AI — Environment Configuration (copy to .env)
# =============================================================================

# --- Core ---
ENVIRONMENT=development
DEBUG=false

# --- Datastores ---
# Async SQLAlchemy DSN (note the +asyncpg driver).
DATABASE_URL=postgresql+asyncpg://modelbox:secret@localhost:5432/modelbox_metadata
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=secret

# --- LLM gateway & governance ---
LLM_GATEWAY_URL=http://localhost:4000
MODEL_ROUTER_CONFIG_PATH=/app/config/model_router.yaml
# Zero-egress mode (FR-6.2): force local-only LLM routing.
AIRGAPPED=false
# Obfuscate sensitive schema/column names before egress.
MASK_METADATA_IN_PROMPTS=false
COST_OPTIMIZATION_MODE=balanced
# AES-256-GCM key material for encrypting stored DB connection URIs at rest.
ENCRYPTION_KEY=dev-encryption-key-change-me

# --- Networking ---
# Allowed CORS origins for the web UI. Comma-separated OR a JSON array both work,
# e.g. http://localhost:3000,http://localhost:13000
# or   ["http://localhost:3000","http://localhost:13000"]
CORS_ORIGINS=http://localhost:3000,http://localhost:13000

# --- LLM provider API keys (leave blank in air-gapped deployments) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
# APAC cloud providers (OpenAI-compatible). Optional fallbacks.
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
INTERNAL_VLLM_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Host port for the web UI. Defaults to 3000; set to 13000 to avoid collisions
# with other local services already bound to :3000.
UI_PORT=13000
