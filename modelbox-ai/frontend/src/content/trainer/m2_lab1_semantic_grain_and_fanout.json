  "expected_flaws": [
    {
      "code": "MISSING_GRAIN",
      "target": "fact_usage",
      "hint": "A semantic model needs one grain. What does a single row of fact_usage mean?",
      "fix": "Declare the grain, e.g. 'one row per feature usage event', on fact_usage."
    },
    {
      "code": "FAN_OUT_RISK",
      "target": "fact_usage -> dim_feature",
      "hint": "A many-to-many join between a fact and a dimension duplicates fact rows and inflates SUM(events).",
      "fix": "Resolve the M:N through a bridge table (or model usage at feature grain) so the join is N:1 through a conformed dimension."
    },
    {
      "code": "MISSING_DESCRIPTION",
      "target": "dim_feature",
      "hint": "Consumers can't trust an undocumented dimension. Which entity has no description?",
      "fix": "Describe dim_feature and its columns."
    }
  ],
  "solution_notes": "The clean model declares a grain on fact_usage, replaces the fact_usage->dim_feature M:N with an N:1 join through a conformed feature dimension (or a bridge at the correct grain), and documents dim_feature. After the fixes, re-validation shows no MISSING_GRAIN, FAN_OUT_RISK, or MISSING_DESCRIPTION issues."
