# =============================================================================
# ModelBox AI — Frontend image (Next.js 14 standalone)
# Build context: ../frontend
# =============================================================================
FROM node:20-alpine AS deps
WORKDIR /app
# `npm ci` installs exactly the lock and fails if it is incomplete, where
# `npm install` would silently repair it (CLAUDE.md, the @esbuild incident).
# The lock is required, so no wildcard on it.
COPY package.json package-lock.json ./
# Install scripts run only after every file is in place: `npm ci` alone ran
# esbuild's install script, which executes the binary it just wrote, while that
# file could still be open for writing (ETXTBSY, CI run 36514885073). The
# installed set is the same; `npm ci` still refuses an incomplete lock.
RUN npm ci --ignore-scripts && npm rebuild

FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
# HOSTNAME: the standalone server listens on the address this resolves to. Left
# to Docker it is the container's hostname, whose address is on one network
# only, so a UI attached to a second network never answers there. Every
# interface, so the published port reaches it on whichever network it uses.
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0

# Next.js standalone output bundles a minimal server + only required deps.
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3000
CMD ["node", "server.js"]
