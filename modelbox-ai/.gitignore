# Offline dbt package cache for the fidelity harness. Populated once by
# backend/scripts/refresh_dbt_packages.py; reproducible from the committed
# backend/tests/fixtures/dbt/package-lock.yml. Not vendored — 6.6 MB of
# third-party SQL buys hermeticity the strict flag already provides.
backend/.dbt-packages/

# --- Node / Next.js ---
node_modules/
.next/
out/
dist/
*.tsbuildinfo
next-env.d.ts

# --- Environment & secrets ---
.env
.env.local
.env.*.local
*.pem

# --- Editor / OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Logs ---
*.log
npm-debug.log*

# The npm stub that appears at the repo root when npm runs one directory above
# `frontend/`. It has `"packages": {}` and nothing resolves it — the real lock is
# `frontend/package-lock.json`. Ignored because it has now been committed twice
# by an `add -A` and removed twice, which is a loop worth ending.
/package-lock.json
